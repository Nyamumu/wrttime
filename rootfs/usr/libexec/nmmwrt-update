#!/bin/sh
# wrtTIME만 업데이트한다 (펌웨어와 무관). GitHub Release의 latest.json + nmmwrt.tar.gz를 쓴다.
#   nmmwrt-update check    -> {"current":"..","latest":"..","sha256":"..","update":true|false} 또는 {"error":".."}
#   nmmwrt-update install  -> 내려받아 sha256 검사 후 설치. 결과는 같은 형식 + "installed"
# __REPO__는 배포할 때 release.conf의 저장소(owner/name)로 바뀐다.
umask 022 # rpcd가 실행하면 umask가 077이다
REPO="__REPO__"
# github.com에 연결되지 않는 망이 있어서(실기기에서 확인) raw.githubusercontent.com의 release 브랜치를 먼저 쓰고, 안 되면 GitHub Release에서 받는다.
RAW="https://raw.githubusercontent.com/$REPO/release"
BASE="https://github.com/$REPO/releases"
WORK=/tmp/nmmwrt-update

# get <저장할 파일> <주소> <대신 쓸 주소>
get() {
	uclient-fetch -q -T 20 -O "$1" "$2" 2>/dev/null && return 0
	rm -f "$1"
	uclient-fetch -q -T 20 -O "$1" "$3" 2>/dev/null
}

fail() { printf '{"error":"%s"}\n' "$1"; rm -rf "$WORK"; exit 1; }

current() { cat /www/nmm/VERSION 2>/dev/null || echo 0.0.0; }

# 1.0.14 -> 비교할 수 있는 숫자
ver_num() { echo "$1" | awk -F. '{ printf "%d%05d%05d\n", $1, $2, $3 }'; }

fetch_latest() {
	case "$REPO" in */*) ;; *) fail "not-configured" ;; esac
	rm -rf "$WORK"; mkdir -p "$WORK" || fail "tmp"
	get "$WORK/latest.json" "$RAW/latest.json" "$BASE/latest/download/latest.json" || fail "download"
	LATEST="$(jsonfilter -i "$WORK/latest.json" -e '@.version' 2>/dev/null)"
	SHA="$(jsonfilter -i "$WORK/latest.json" -e '@.sha256' 2>/dev/null)"
	echo "$LATEST" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || fail "bad-manifest"
	echo "$SHA" | grep -qE '^[0-9a-f]{64}$' || fail "bad-manifest"
}

report() {
	CUR="$(current)"
	UPD=false; [ "$(ver_num "$LATEST")" -gt "$(ver_num "$CUR")" ] 2>/dev/null && UPD=true
	printf '{"repo":"%s","current":"%s","latest":"%s","sha256":"%s","update":%s%s}\n' "$REPO" "$CUR" "$LATEST" "$SHA" "$UPD" "$1"
}

case "$1" in
check)
	fetch_latest
	report ""
	rm -rf "$WORK"
	;;
install)
	fetch_latest
	get "$WORK/n.tgz" "$RAW/nmmwrt-$LATEST.tar.gz" "$BASE/download/v$LATEST/nmmwrt.tar.gz" || fail "download"
	[ "$(sha256sum "$WORK/n.tgz" | cut -d' ' -f1)" = "$SHA" ] || fail "checksum"
	# 정해진 위치의 파일만 들어 있어야 한다
	tar -tzf "$WORK/n.tgz" > "$WORK/list" 2>/dev/null || fail "archive"
	grep -qvE '^(\./)?(www/|www/index\.html|www/nmm/[A-Za-z0-9._/-]*|usr/|usr/libexec/|usr/libexec/nmmwrt-update|usr/share/|usr/share/rpcd/|usr/share/rpcd/acl\.d/|usr/share/rpcd/acl\.d/easyui\.json|lib/|lib/upgrade/|lib/upgrade/keep\.d/|lib/upgrade/keep\.d/nmmwrt)$' "$WORK/list" && fail "archive"
	grep -qE '^(\./)?www/nmm/index\.html$' "$WORK/list" || fail "archive"
	# 원래 첫 화면(LuCI로 보내는 파일)은 처음 한 번 보관한다
	if [ -f /www/index.html ] && ! grep -q NMMWRT-ROOT /www/index.html; then cp /www/index.html /www/index.html.luci; fi
	rm -rf /www/nmm
	# 패키지의 www, usr, lib만 / 에 푼다. / 자체의 권한은 건드리면 안 된다:
	# 700이 되면 ubusd(ubus 계정)가 /etc/passwd를 못 읽어 새 ubus 연결이 모두 실패한다 (1.0.14~1.0.15의 cp -a 버그).
	tar -xzf "$WORK/n.tgz" -C / || fail "copy"
	chmod 755 /
	report ',"installed":true'
	rm -rf "$WORK"
	# 응답을 돌려준 뒤에 권한을 다시 읽는다
	( sleep 2; /etc/init.d/rpcd reload ) </dev/null >/dev/null 2>&1 &
	;;
*)
	echo "usage: $0 check|install" >&2
	exit 2
	;;
esac
