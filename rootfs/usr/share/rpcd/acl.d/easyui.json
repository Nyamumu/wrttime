{
	"easyui": {
		"description": "wrtTIME 관리 UI",
		"read": {
			"ubus": {
				"system": [ "info", "board" ],
				"rpc-sys": [ "packagelist" ],
				"network.interface": [ "dump" ],
				"network.device": [ "status" ],
				"network.wireless": [ "status" ],
				"file": [ "read", "list" ],
				"session": [ "destroy" ],
				"uci": [ "get", "changes", "configs" ],
				"log": [ "read" ],
				"iwinfo": [ "devices", "phyname", "info", "txpowerlist", "countrylist", "assoclist" ]
			},
			"uci": [ "network", "dhcp", "wireless", "firewall", "system", "ddns", "sqm", "igmpproxy", "upnpd", "dropbear", "banip", "uhttpd", "attendedsysupgrade" ],
			"file": {
				"/etc/apk/keys": [ "list" ],
				"/etc/apk/keys/*": [ "read" ],
				"/etc/banip/banip.countries": [ "read" ],
				"/var/run/banIP/banIP.runtime.json": [ "read" ],
				"/tmp/run/banIP/banIP.runtime.json": [ "read" ],
				"/etc/dropbear/authorized_keys": [ "read" ],
				"/tmp/dhcp.leases": [ "read" ],
				"/etc/board.json": [ "read" ],
				"/etc/rc.d": [ "list" ],
				"/etc/crontabs/root": [ "read" ],
				"/var/run/miniupnpd.leases": [ "read" ],
				"/tmp/run/miniupnpd.leases": [ "read" ],
				"/run/miniupnpd.leases": [ "read" ],
				"/usr/share/luci/menu.d": [ "list" ],
				"/usr/share/luci/menu.d/*": [ "read" ],
				"/lib/apk/db/installed": [ "read" ],
				"/usr/bin/apk list *": [ "exec" ],
				"/usr/bin/apk search -v *": [ "exec" ],
				"/usr/libexec/nmmwrt-update check": [ "exec" ],
				"/sys/class/leds": [ "list" ],
				"/sys/class/leds/*/trigger": [ "read" ],
				"/sys/devices/*/trigger": [ "read" ],
				"/sys/class/net/*/brforward": [ "read" ],
				"/sys/class/net/*/brif": [ "list" ],
				"/sys/class/net/*/brif/*/port_no": [ "read" ],
				"/sys/devices/*/brforward": [ "read" ],
				"/sys/devices/*/brif": [ "list" ],
				"/sys/devices/*/brport/port_no": [ "read" ]
			},
			"cgi-io": [ "backup" ]
		},
		"write": {
			"ubus": {
				"uci": [ "set", "add", "delete", "revert", "apply", "confirm", "rollback" ],
				"rpc-sys": [ "password_set", "factory", "upgrade_start" ],
				"system": [ "reboot", "validate_firmware_image" ],
				"network.interface.*": [ "up", "down" ],
				"hostapd.*": [ "del_client" ],
				"file": [ "exec", "write", "remove" ]
			},
			"uci": [ "network", "dhcp", "wireless", "firewall", "system", "ddns", "sqm", "igmpproxy", "upnpd", "dropbear", "banip", "uhttpd" ],
			"file": {
				"/etc/apk/keys/*": [ "write" ],
				"/etc/init.d/banip enable": [ "exec" ],
				"/etc/init.d/banip restart": [ "exec" ],
				"/etc/init.d/banip stop": [ "exec" ],
				"/etc/init.d/igmpproxy enable": [ "exec" ],
				"/etc/init.d/igmpproxy disable": [ "exec" ],
				"/etc/init.d/igmpproxy restart": [ "exec" ],
				"/etc/init.d/igmpproxy stop": [ "exec" ],
				"/etc/init.d/miniupnpd enable": [ "exec" ],
				"/etc/init.d/miniupnpd restart": [ "exec" ],
				"/etc/init.d/miniupnpd stop": [ "exec" ],
				"/etc/init.d/cron enable": [ "exec" ],
				"/etc/init.d/cron restart": [ "exec" ],
				"/etc/crontabs/root": [ "write" ],
				"/bin/ping -c 4 -W 2 -4 *": [ "exec" ],
				"/bin/ping -c 4 -W 2 -6 *": [ "exec" ],
				"/usr/bin/ping -c 4 -W 2 -4 *": [ "exec" ],
				"/usr/bin/ping -c 4 -W 2 -6 *": [ "exec" ],
				"/usr/bin/traceroute -n -q 1 -w 2 -m 20 -4 *": [ "exec" ],
				"/usr/bin/traceroute -n -q 1 -w 2 -m 20 -6 *": [ "exec" ],
				"/bin/traceroute -n -q 1 -w 2 -m 20 -4 *": [ "exec" ],
				"/bin/traceroute -n -q 1 -w 2 -m 20 -6 *": [ "exec" ],
				"/usr/bin/nslookup *": [ "exec" ],
				"/bin/nslookup *": [ "exec" ],
				"/etc/dropbear/authorized_keys": [ "write" ],
				"/tmp/firmware.bin": [ "write" ],
				"/tmp/backup.tar.gz": [ "write" ],
				"/sbin/sysupgrade --restore-backup /tmp/backup.tar.gz": [ "exec" ],
				"/etc/init.d/led restart": [ "exec" ],
				"/usr/libexec/nmmwrt-update install": [ "exec" ],
				"/tmp/upload.apk": [ "write" ],
				"/usr/bin/apk update": [ "exec" ],
				"/usr/bin/apk add *": [ "exec" ],
				"/usr/bin/apk del *": [ "exec" ],
				"/usr/bin/apk upgrade *": [ "exec" ]
			},
			"cgi-io": [ "upload" ]
		}
	}
}
